<mujoco model="go2 scene">
  <include file="go2.xml" />

  <statistic center="0 0 0.1" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
  </asset>

  <default>
    <default class="rail">
      <geom type="box" rgba="0.3 0.3 0.3 1"/>

      <default class="post_short">
        <geom size="0.015 0.015 0.3"/>
      </default>

      <default class="post_tall">
        <geom size="0.015 0.015 0.6"/>
      </default>

      <default class="bar_sloped">
        <geom size="0.015 0.015 0.5" euler="0 0.9273 0"/>
      </default>

      <default class="bar_flat">
         <geom size="0.5 0.015 0.015"/>
      </default>
    </default>

    <default class="step_std">
        <geom type="box" size="0.1 0.4 0.015"/>
    </default>
    <default class="step_platform">
        <geom type="box" size="0.5 0.4 0.015"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />

    <geom class="step_std" pos="-5.8 0.0 0.15"/>
    <geom class="step_std" pos="-5.6 0.0 0.30"/>
    <geom class="step_std" pos="-5.4 0.0 0.45"/>
    <geom class="step_std" pos="-5.2 0.0 0.60"/>
    <geom class="step_platform" pos="-4.6 0.0 0.75"/>

    <geom class="post_short" pos="-5.885 0.385 0.3"/>
    <geom class="post_short" pos="-5.885 -0.385 0.3"/>
    
    <geom class="post_tall" pos="-5.085 0.385 0.6"/>
    <geom class="post_tall" pos="-5.085 -0.385 0.6"/>

    <geom class="post_tall" pos="-4.115 0.385 0.6"/>
    <geom class="post_tall" pos="-4.115 -0.385 0.6"/>

    <geom class="bar_sloped" pos="-5.485 0.385 0.5"/>
    <geom class="bar_sloped" pos="-5.485 0.385 0.7"/>
    <geom class="bar_sloped" pos="-5.485 0.385 0.9"/>
    
    <geom class="bar_sloped" pos="-5.485 -0.385 0.5"/>
    <geom class="bar_sloped" pos="-5.485 -0.385 0.7"/>
    <geom class="bar_sloped" pos="-5.485 -0.385 0.9"/>

    <geom class="bar_flat" pos="-4.6 0.385 1.0"/>
    <geom class="bar_flat" pos="-4.6 0.385 1.2"/>
    
    <geom class="bar_flat" pos="-4.6 -0.385 1.0"/>
    <geom class="bar_flat" pos="-4.6 -0.385 1.2"/>

  </worldbody>
</mujoco>